# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/orbitly_studio

# JWT Secret Key for Authentication
JWT_SECRET=orbitly_studio_super_secret_jwt_key_2025

# Allowed Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Cloudinary Configuration for Image Uploads
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Resend Email Configuration for Inquiries
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Orbitly Studio <onboarding@resend.dev>
ADMIN_NOTIFICATION_EMAIL=admin@orbitly.studio
